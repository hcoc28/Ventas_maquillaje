# Cadena usada por la CLI de Prisma (migrate/db push).
DATABASE_URL="sqlserver://<host>:1433;database=<database>;user=<usuario>;password=<password>;trustServerCertificate=true;"

# Credenciales usadas en tiempo de ejecución por la app (driver adapter @prisma/adapter-mssql).
DB_SERVER=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=50200000000

# Bot de WhatsApp (Meta Cloud API) — ver README para la guía de configuración.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auth.js — generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Rate limiting compartido (Upstash Redis). Sin estas variables, cae a un limitador en memoria
# (suficiente en local, pero no en Vercel/serverless). Crea una base gratis en upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Obligatoria en producción para `npm run db:seed` — nunca reutilices la contraseña de demo
# del README como Administrador real.
SEED_ADMIN_PASSWORD=

# Resend (correos transaccionales: recuperar contraseña, confirmación de pedido, bienvenida).
# Sin RESEND_API_KEY, los envíos se omiten silenciosamente (solo se registran en consola).
RESEND_API_KEY=
RESEND_FROM_EMAIL="Amour Bloom <onboarding@resend.dev>"

# Google Analytics 4 — Measurement ID de tu propiedad (analytics.google.com). Sin esta variable,
# no se carga ningún script de analítica.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry (monitoreo de errores) — DSN de tu proyecto en sentry.io. Sin esta variable, Sentry
# queda deshabilitado por completo (no se envía nada).
NEXT_PUBLIC_SENTRY_DSN=
# Opcionales — solo si quieres que las stack traces en producción se vean con el código fuente
# real en vez de minificado (requiere un Auth Token de sentry.io con permiso de subir source maps).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
